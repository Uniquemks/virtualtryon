# FastAPI Backend Environment Variables
# Copy this file to .env and replace the values with your credentials

# Magic Hour API Key (Required for Head + Hair Swap)
MAGIC_HOUR_API_KEY=your_magic_hour_api_key_here

# Replicate API Key (Required for IDM-VTON virtual try-on)
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Port for FastAPI server
PORT=5001
